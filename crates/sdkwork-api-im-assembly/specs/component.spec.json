  "integration": {
    "authority": "Root SDKWork specs remain authoritative. This component owns IM application-plane router assembly and must not redefine API contracts owned by route crates.",
    "dependencyPolicy": "Gateway assembly composes application-owned route crates through Cargo workspace dependencies and declared router entrypoints; standalone and cloud gateway hosts consume this assembly instead of hand-merging route matrices.",
