    "languagePolicy": "Rust source follows Cargo workspace dependencies and the SDKWork Rust crate responsibility split."
  },
  "verification": {
    "commands": [
      "cargo test -p sdkwork-api-im-assembly --test route_merge_smoke -- --nocapture",
