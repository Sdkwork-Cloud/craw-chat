[runtime]
environment = "production"
deployment_mode = "desktop"
app_code = "chat"

[paths]
config_directory = "~/.sdkwork/chat/config"
config_file = "~/.sdkwork/chat/config/chat.toml"
data_directory = "~/.sdkwork/chat/data"
log_directory = "~/.sdkwork/chat/logs"
cache_directory = "~/.sdkwork/chat/cache"
runtime_directory = "~/.sdkwork/chat/tmp"

# IM business database uses PostgreSQL. Desktop standalone deployments must
# connect to a local or remote PostgreSQL instance. SQLite is not supported
# as an IM business store (no SQLite adapter is implemented in this repo).
[database]
engine = "postgres"
url = "postgresql://sdkwork:sdkwork@127.0.0.1:5432/chat"
max_connections = 8
auto_migrate = true

[redis]
enabled = false
key_prefix = "chat"
