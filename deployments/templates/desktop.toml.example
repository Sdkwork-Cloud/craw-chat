[runtime]
environment = "production"
deployment_profile = "standalone"
runtime_target = "desktop"
app_code = "chat"

[paths]
config_directory = "~/.sdkwork/chat/config"
config_file = "~/.sdkwork/chat/config/chat.toml"
data_directory = "~/.sdkwork/chat/data"
log_directory = "~/.sdkwork/chat/logs"
cache_directory = "~/.sdkwork/chat/cache"
runtime_directory = "~/.sdkwork/chat/tmp"

# Desktop user data is client-local browser/native storage. A backend service
# started for desktop development uses the separate server PostgreSQL profile.

[redis]
enabled = false
key_prefix = "chat"
