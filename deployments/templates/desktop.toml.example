[runtime]
environment = "production"
deployment_profile = "standalone"
runtime_target = "desktop"
app_code = "chat"

[paths]
config_directory = "~/.sdkwork/im/config"
config_file = "~/.sdkwork/im/config/config.toml"
data_directory = "~/.sdkwork/im/data"
log_directory = "~/.sdkwork/im/logs"
cache_directory = "~/.sdkwork/im/cache"
runtime_directory = "~/.sdkwork/im/tmp"

# Desktop user data is client-local browser/native storage. A backend service
# started for desktop development uses the separate server PostgreSQL profile.

[redis]
enabled = false
key_prefix = "chat"
