<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.sdkwork.im.api-standalone-gateway</string>

  <key>ProgramArguments</key>
  <array>
    <string>__INSTALL_ROOT__/bin/sdkwork-api-im-standalone-gateway</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__INSTALL_ROOT__</string>

  <key>RunAtLoad</key>
