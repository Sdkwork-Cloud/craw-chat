# sdkwork-im standalone docker compose environment template.
# Copy next to docker-compose.yml as `.env` and adjust values:
#   cp deployments/docker/.env.example deployments/docker/.env
# docker compose reads `.env` next to docker-compose.yml automatically.
# Every value below has a built-in local-development default, so this file is
# optional; it exists to make deployment-time configuration explicit.

# --- Process log level (tracing reads RUST_LOG directly) ---
# Set to debug/trace to increase verbosity at deployment time.
RUST_LOG=info

# --- Gateway resource guardrails (docker compose deploy limits) ---
SDKWORK_IM_CPU_LIMIT=4.0
SDKWORK_IM_MEMORY_LIMIT=4g
SDKWORK_IM_CPU_RESERVATION=1.0
SDKWORK_IM_MEMORY_RESERVATION=1g

# --- Host port ---
# The gateway container listens on 18079; the host maps 18079 -> 18079 so the
# PC renderer's local gateway discovery (127.0.0.1:18079) keeps working from
# Windows browsers. Change only when another process already owns WSL port
# 18079; the PC renderer default discovery then no longer matches.
SDKWORK_IM_HOST_PORT=18079

# --- Deployment identity ---
# development enables the IAM credential-entry login flow with the
# gateway-issued bootstrap Access-Token (dev authentication fallback).
# Production deployments must set a production value and provide
# SDKWORK_IAM_SIGNING_MASTER_SECRET / signed tokens.
SDKWORK_IM_ENVIRONMENT=development
SDKWORK_IM_PROFILE_ID=standalone.container.development

# --- Browser CORS allow-list (SDKWORK_CORS_ALLOWED_ORIGINS is the canonical
# shared key for every SDKWork service) ---
SDKWORK_CORS_ALLOWED_ORIGINS=http://testapidocker.sdkwork.com,http://testapidocker.birdcoder.com,http://testapidocker.dtupay.com,http://127.0.0.1:18079,http://localhost:18079,http://localhost

# --- PostgreSQL (compose `postgres` service) ---
# The database name must be a canonical SDKWork workspace identity
# (sdkwork_ai_dev/test/staging/prod) with the matching username; the schema
# must equal the name. sdkwork_ai_dev pairs with SDKWORK_IM_ENVIRONMENT=development.
SDKWORK_IM_POSTGRES_DB=sdkwork_ai_dev
SDKWORK_IM_POSTGRES_SCHEMA=sdkwork_ai_dev
SDKWORK_IM_POSTGRES_USER=sdkwork_ai_dev
# Change this password for anything beyond a throwaway local deployment.
SDKWORK_IM_POSTGRES_PASSWORD=sdkworkdev123
# PostgreSQL server-side connection ceiling (default 200).
IM_PG_MAX_CONNECTIONS=200

# --- Connection pools ---
SDKWORK_IM_DATABASE_MAX_CONNECTIONS=50
SDKWORK_IM_DATABASE_MIN_CONNECTIONS=5
SDKWORK_IM_DATABASE_ACQUIRE_TIMEOUT=30
SDKWORK_IM_DATABASE_IDLE_TIMEOUT=600
SDKWORK_IM_DATABASE_MAX_LIFETIME=1800
SDKWORK_IM_DATABASE_SEED_LOCALE=zh-CN

# --- IAM ---
# Super-admin bootstrap password: when set, the IAM bootstrap provisions/
# updates the password credential for the default admin user. Leave empty for
# throwaway local deployments; set it for anything real.
SDKWORK_IAM_SUPER_ADMIN_PASSWORD=
