# Sdkwork IM local PostgreSQL + Redis development profile.
# Copy this file to .env.postgres and change values for your local setup.
# Do not commit .env.postgres.
#
# PostgreSQL connection identity is unified across all SDKWork applications.
# See sdkwork-specs/ENVIRONMENT_SPEC.md section 7.1.

# ===========================================================================
# Storage provider selection
# ===========================================================================
SDKWORK_IM_STORAGE_PROVIDER=postgresql

# ===========================================================================
# Workspace PostgreSQL profile
# ===========================================================================
SDKWORK_DATABASE_ENGINE=postgresql
SDKWORK_DATABASE_HOST=127.0.0.1
SDKWORK_DATABASE_PORT=5432
SDKWORK_DATABASE_NAME=sdkwork_ai_dev
SDKWORK_DATABASE_SCHEMA=sdkwork_ai_dev
SDKWORK_DATABASE_SCHEMA_FALLBACK_PUBLIC=false
SDKWORK_DATABASE_USERNAME=sdkwork_ai_dev
SDKWORK_DATABASE_PASSWORD=sdkworkdev123
# Dev profile permits disable; production deployments MUST set this to `require`.
SDKWORK_DATABASE_SSL_MODE=disable
SDKWORK_DATABASE_MAX_CONNECTIONS=10
SDKWORK_DATABASE_TEMPORARY_ANY_POOL_EXCEPTION=true
SDKWORK_DATABASE_TEMPORARY_DRIVER_POOL_COUNT=2
SDKWORK_IM_CONVERSATION_MAX_IN_MEMORY=10000
SDKWORK_IM_CONVERSATION_CACHE_MAX_BYTES=536870912

# ===========================================================================
# Redis (realtime event windows, checkpoints, sequence allocator, cluster bus)
# ===========================================================================
SDKWORK_IM_REDIS_ENABLED=true
SDKWORK_IM_REDIS_HOST=127.0.0.1
SDKWORK_IM_REDIS_PORT=6379
SDKWORK_IM_REDIS_DATABASE=0
SDKWORK_IM_REDIS_KEY_PREFIX=chat
SDKWORK_IM_REDIS_TLS=false
SDKWORK_IM_REDIS_URL=redis://127.0.0.1:6379/0

# Optional Redis-backed realtime route store / cluster bus (multi-node or HA dev).
# When either URL below is set, you must also set SDKWORK_IM_REALTIME_NODE_ID and
# SDKWORK_IM_REALTIME_CLUSTER_BUS_SECRET (default node id is rejected in cluster mode).
# SDKWORK_IM_REALTIME_ROUTE_STORE_URL=redis://127.0.0.1:6379/0
# SDKWORK_IM_REALTIME_CLUSTER_BUS_URL=redis://127.0.0.1:6379/0
# SDKWORK_IM_REALTIME_CLUSTER_BUS_SECRET=generate-a-strong-random-secret
# SDKWORK_IM_REALTIME_NODE_ID=session_gateway_dev_1

# ===========================================================================
# Snowflake ID generator (required in multi-node deployments)
# ===========================================================================
SDKWORK_IM_ID_NODE_ID=0

# ===========================================================================
# Admin database credentials (for pnpm db:postgres:init / migrations)
# ===========================================================================
SDKWORK_DATABASE_ADMIN_HOST=127.0.0.1
SDKWORK_DATABASE_ADMIN_PORT=5432
SDKWORK_DATABASE_ADMIN_USERNAME=postgres
SDKWORK_DATABASE_ADMIN_PASSWORD=postgres_admin_pass
SDKWORK_DATABASE_ADMIN_DATABASE=postgres
# Dev profile permits disable; production deployments MUST set this to `require`.
SDKWORK_DATABASE_ADMIN_SSL_MODE=disable
# SDKWORK_DATABASE_ADMIN_URL=postgresql://sdkwork_ai_dev:postgres_admin_pass@127.0.0.1:5432/sdkwork_ai_dev?sslmode=disable

# ===========================================================================
# AppContext / JWT (development defaults)
# ===========================================================================
SDKWORK_IM_ENVIRONMENT=dev
SDKWORK_IM_APP_CONTEXT_JWT_TENANT_ID=100001
SDKWORK_IM_APP_CONTEXT_JWT_KEY_ID=bootstrap
SDKWORK_IM_APP_CONTEXT_REQUIRE_SIGNATURE=false

# Production: enable signature verification and configure secrets via secret manager or *_FILE keys.
# SDKWORK_IM_APP_CONTEXT_REQUIRE_SIGNATURE=true
# SDKWORK_IM_APP_CONTEXT_SIGNATURE_SECRET_FILE=/run/secrets/app-context-signature-secret
# SDKWORK_IM_APP_CONTEXT_JWT_SIGNING_SECRET_FILE=/run/secrets/jwt-signing-secret

# ===========================================================================
# WebSocket (session-gateway)
# ===========================================================================
SDKWORK_IM_WEBSOCKET_HEARTBEAT_INTERVAL_SECS=30
SDKWORK_IM_WEBSOCKET_IDLE_TIMEOUT_SECS=90
SDKWORK_IM_SESSION_GATEWAY_WS_RATE_MAX_BUCKETS=50000

# ===========================================================================
# Retention cleanup
# ===========================================================================
SDKWORK_IM_RETENTION_PURGE_ENABLED=true
SDKWORK_IM_RETENTION_PURGE_SCHEDULER_ENABLED=true
SDKWORK_IM_RETENTION_PURGE_INTERVAL_SECONDS=3600
SDKWORK_IM_RETENTION_PURGE_BATCH_SIZE=500
SDKWORK_IM_RETENTION_PURGE_MAX_BATCHES_PER_TICK=100
SDKWORK_IM_SHARED_CHANNEL_SYNC_STALE_RECLAIM_SCHEDULER_ENABLED=true
SDKWORK_IM_SHARED_CHANNEL_SYNC_STALE_RECLAIM_INTERVAL_SECONDS=60

# Conversation and Social opaque cursor signing (shared by all service replicas).
# Dev-only placeholders; production/staging MUST inject independent strong secrets.
SDKWORK_IM_CONVERSATION_STATE_CURSOR_HS256_SECRET=dev-conversation-state-cursor-hs256-secret-change-me
SDKWORK_IM_FRIEND_REQUEST_CURSOR_HS256_SECRET=dev-friend-request-cursor-hs256-secret-change-me

# Conversation message history opaque cursor signing (shared by all service replicas).
# Dev-only placeholder; production/staging MUST inject a strong random secret.
SDKWORK_IM_MESSAGE_HISTORY_CURSOR_HS256_SECRET=dev-message-history-cursor-hs256-secret-change-me

# ===========================================================================
# Observability (optional OpenTelemetry export)
# ===========================================================================
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# ===========================================================================
# Production tuning (comment-only guidance; override in .env.postgres locally)
# ===========================================================================
# SDKWORK_DATABASE_MAX_CONNECTIONS=50
# SDKWORK_DATABASE_MIN_CONNECTIONS=10
# SDKWORK_DATABASE_IDLE_TIMEOUT=300
# SDKWORK_DATABASE_ACQUIRE_TIMEOUT=10
# SDKWORK_IM_REDIS_PASSWORD=<GENERATE_UNIQUE_STRONG_PASSWORD_IF_REQUIRED>
# SDKWORK_IM_REALTIME_EVENT_WINDOW_MAX_LIMIT=1000
# SDKWORK_IM_REALTIME_CLIENT_ROUTE_WINDOW_MAX_RETAINED_EVENTS=1000
