# cloud.development
SDKWORK_IM_DEPLOYMENT_PROFILE=cloud
SDKWORK_IM_ENVIRONMENT=development
SDKWORK_IM_PROFILE_ID=cloud.development

SDKWORK_IM_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:18079
SDKWORK_IM_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:18079
SDKWORK_IM_APPLICATION_PUBLIC_WEBSOCKET_URL=ws://127.0.0.1:18079
SDKWORK_IM_PLATFORM_API_GATEWAY_AUTOSTART=false

# Multi-transport realtime link listeners (optional).
# Uncomment to enable TCP/UDP/QUIC transports alongside WebSocket.
# SDKWORK_IM_REALTIME_TCP_BIND_ADDR=127.0.0.1:18080
# SDKWORK_IM_REALTIME_UDP_BIND_ADDR=127.0.0.1:18081
# SDKWORK_IM_REALTIME_QUIC_BIND_ADDR=127.0.0.1:18082
# SDKWORK_IM_REALTIME_QUIC_TLS_CERT_PATH=./certs/quic.crt
# SDKWORK_IM_REALTIME_QUIC_TLS_KEY_PATH=./certs/quic.key

VITE_SDKWORK_IM_DEPLOYMENT_PROFILE=cloud
VITE_SDKWORK_IM_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:18079
VITE_SDKWORK_IM_APPLICATION_PUBLIC_WEBSOCKET_URL=ws://127.0.0.1:18079
VITE_SDKWORK_IM_PLATFORM_API_GATEWAY_HTTP_URL=http://127.0.0.1:18079
SDKWORK_API_CLOUD_GATEWAY_CONFIG=configs/sdkwork-api-cloud-gateway.sdkwork-im.development.toml
