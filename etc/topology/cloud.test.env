# cloud.test
SDKWORK_IM_DEPLOYMENT_PROFILE=cloud
SDKWORK_IM_ENVIRONMENT=test
SDKWORK_IM_PROFILE_ID=cloud.test
SDKWORK_DATABASE_TEMPORARY_DRIVER_POOL_COUNT=1

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_IM_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

SDKWORK_IM_APPLICATION_PUBLIC_HTTP_URL=https://im-test.sdkwork.com
SDKWORK_IM_APPLICATION_PUBLIC_WEBSOCKET_URL=wss://api-test.sdkwork.com
SDKWORK_IM_PLATFORM_API_GATEWAY_HTTP_URL=https://api-test.sdkwork.com

VITE_SDKWORK_IM_DEPLOYMENT_PROFILE=cloud
VITE_SDKWORK_IM_APPLICATION_PUBLIC_HTTP_URL=https://im-test.sdkwork.com
VITE_SDKWORK_IM_APPLICATION_PUBLIC_WEBSOCKET_URL=wss://api-test.sdkwork.com
VITE_SDKWORK_IM_PLATFORM_API_GATEWAY_HTTP_URL=https://api-test.sdkwork.com
SDKWORK_IM_CONVERSATION_MAX_IN_MEMORY=10000
SDKWORK_IM_CONVERSATION_CACHE_MAX_BYTES=536870912

SDKWORK_IM_H5_FEEDS_OPEN_API_BASE_URL=https://api.test.invalid

# Community (圈子) and feeds embedded domains: anonymous public surfaces resolve the
# seeded demo tenant (100001) when no IAM context is present.
COMMUNITY_DEFAULT_TENANT_ID=100001
SDKWORK_FEEDS_DEFAULT_TENANT_ID=100001
VITE_SDKWORK_IM_H5_FEEDS_OPEN_API_BASE_URL=https://api.test.invalid

