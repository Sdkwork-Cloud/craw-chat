# cloud.staging
SDKWORK_IM_DEPLOYMENT_PROFILE=cloud
SDKWORK_IM_ENVIRONMENT=staging
SDKWORK_IM_PROFILE_ID=cloud.staging
SDKWORK_DATABASE_TEMPORARY_DRIVER_POOL_COUNT=1


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_IM_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

SDKWORK_IM_APPLICATION_PUBLIC_HTTP_URL=https://im-staging.sdkwork.com
SDKWORK_IM_APPLICATION_PUBLIC_WEBSOCKET_URL=wss://im-staging.sdkwork.com
SDKWORK_IM_PLATFORM_API_GATEWAY_HTTP_URL=https://api-staging.sdkwork.com

SDKWORK_DATABASE_ENGINE=postgresql
SDKWORK_DATABASE_HOST=db-staging.example.com
SDKWORK_DATABASE_PORT=5432
SDKWORK_DATABASE_NAME=sdkwork_ai_staging
SDKWORK_DATABASE_SCHEMA=sdkwork_ai_staging
SDKWORK_DATABASE_USERNAME=sdkwork_ai_staging
SDKWORK_DATABASE_PASSWORD_FILE=/run/secrets/sdkwork/database-password
SDKWORK_DATABASE_SSL_MODE=require
SDKWORK_DATABASE_MAX_CONNECTIONS=24
SDKWORK_IM_CONVERSATION_MAX_IN_MEMORY=10000
SDKWORK_IM_CONVERSATION_CACHE_MAX_BYTES=536870912

VITE_SDKWORK_IM_DEPLOYMENT_PROFILE=cloud
VITE_SDKWORK_IM_APPLICATION_PUBLIC_HTTP_URL=https://im-staging.sdkwork.com
VITE_SDKWORK_IM_APPLICATION_PUBLIC_WEBSOCKET_URL=wss://im-staging.sdkwork.com
VITE_SDKWORK_IM_PLATFORM_API_GATEWAY_HTTP_URL=https://api-staging.sdkwork.com

SDKWORK_IM_APP_CONTEXT_REQUIRE_SIGNATURE=true
SDKWORK_IM_APP_CONTEXT_SIGNATURE_SECRET_FILE=/run/secrets/sdkwork/app-context-signature-secret
SDKWORK_IM_APP_CONTEXT_JWT_TENANT_ID=100001
SDKWORK_IM_APP_CONTEXT_JWT_KEY_ID=bootstrap
SDKWORK_IM_APP_CONTEXT_JWT_SIGNING_SECRET_FILE=/run/secrets/sdkwork/jwt-signing-secret
SDKWORK_IM_JWT_REQUIRE_JTI=true
SDKWORK_IM_JWT_REPLAY_CACHE_TTL_SECS=300
SDKWORK_IM_JWT_REPLAY_REDIS_URL=redis://redis-staging.internal:6379/0
