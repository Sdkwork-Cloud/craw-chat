{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "react": [
        "./node_modules/@types/react/index.d.ts"
      ],
      "react/jsx-runtime": [
        "./node_modules/@types/react/jsx-runtime.d.ts"
      ],
      "react-dom": [
        "./node_modules/@types/react-dom/index.d.ts"
      ],
      "react-router-dom": [
        "./node_modules/react-router-dom/dist/index.d.ts"
      ],
      "sdkwork-voice-pc-core": [
        "./../../../sdkwork-voice/apps/sdkwork-voice-pc/packages/sdkwork-voice-pc-core/src"
      ],
      "sdkwork-voice-pc-commons": [
        "./../../../sdkwork-voice/apps/sdkwork-voice-pc/packages/sdkwork-voice-pc-commons/src"
      ],
      "sdkwork-drive-pc-core": [
        "./../../../sdkwork-drive/apps/sdkwork-drive-pc/packages/sdkwork-drive-pc-core/src"
      ],
      "sdkwork-drive-pc-commons": [
        "./../../../sdkwork-drive/apps/sdkwork-drive-pc/packages/sdkwork-drive-pc-commons/src"
      ],
      "sdkwork-drive-pc-file": [
        "./../../../sdkwork-drive/apps/sdkwork-drive-pc/packages/sdkwork-drive-pc-file/src"
      ],
      "sdkwork-drive-pc-transfer": [
        "./../../../sdkwork-drive/apps/sdkwork-drive-pc/packages/sdkwork-drive-pc-transfer/src"
      ],
      "sdkwork-drive-pc-types": [
        "./../../../sdkwork-drive/apps/sdkwork-drive-pc/packages/sdkwork-drive-pc-types/src"
      ],
      "@packages/*": [
        "./../../../sdkwork-knowledgebase/apps/sdkwork-knowledgebase-pc/packages/*"
      ],
      "sdkwork-knowledgebase-pc-core": [
        "./../../../sdkwork-knowledgebase/apps/sdkwork-knowledgebase-pc/packages/sdkwork-knowledgebase-pc-core/src"
      ],
      "sdkwork-knowledgebase-pc-core/host/hostAdapter": [
        "./../../../sdkwork-knowledgebase/apps/sdkwork-knowledgebase-pc/packages/sdkwork-knowledgebase-pc-core/src/host/hostAdapter.ts"
      ],
      "@packages/sdkwork-knowledgebase-pc-commons/src": [
        "./../../../sdkwork-knowledgebase/apps/sdkwork-knowledgebase-pc/packages/sdkwork-knowledgebase-pc-commons/src"
      ],
      "@packages/sdkwork-knowledgebase-pc-commons/src/*": [
        "./../../../sdkwork-knowledgebase/apps/sdkwork-knowledgebase-pc/packages/sdkwork-knowledgebase-pc-commons/src/*"
      ],
      "@sdkwork/community-app-sdk": [
        "./../../../sdkwork-community/sdks/sdkwork-community-app-sdk/sdkwork-community-app-sdk-typescript/src/index.ts"
      ],
      "@sdkwork/community-runtime": [
        "./../../../sdkwork-community/apps/sdkwork-community-common/packages/sdkwork-community-runtime/src/index.ts"
      ],
      "@sdkwork/community-sdk-ports": [
        "./../../../sdkwork-community/apps/sdkwork-community-common/packages/sdkwork-community-sdk-ports/src/index.ts"
      ],
      "@sdkwork/community-contracts": [
        "./../../../sdkwork-community/apps/sdkwork-community-common/packages/sdkwork-community-contracts/src/index.ts"
      ],
      "@sdkwork/course-app-sdk": [
        "./../../../sdkwork-course/sdks/sdkwork-course-app-sdk/sdkwork-course-app-sdk-typescript/src/index.ts"
      ],
      "@sdkwork/course-backend-sdk": [
        "./../../../sdkwork-course/sdks/sdkwork-course-backend-sdk/sdkwork-course-backend-sdk-typescript/src/index.ts"
      ],
      "@sdkwork/course-runtime": [
        "./../../../sdkwork-course/apps/sdkwork-course-common/packages/sdkwork-course-runtime/src/index.ts"
      ],
      "@sdkwork/course-sdk-ports": [
        "./../../../sdkwork-course/apps/sdkwork-course-common/packages/sdkwork-course-sdk-ports/src/index.ts"
      ],
      "@sdkwork/course-contracts": [
        "./../../../sdkwork-course/sdks/_shared/course-contracts/src/index.ts"
      ],
      "@sdkwork/course-mobile-react-courses": [
        "./../../../sdkwork-course/apps/sdkwork-course-common/packages/sdkwork-course-mobile-react-courses/src/index.ts"
      ],
      "@sdkwork/course-pc-course": [
        "./../../../sdkwork-course/apps/sdkwork-course-pc/packages/sdkwork-course-pc-course/src/index.ts"
      ],
      "@sdkwork/course-pc-console": [
        "./../../../sdkwork-course/apps/sdkwork-course-pc/packages/sdkwork-course-pc-console/src/index.ts"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "exclude": [
    "dist",
    "node_modules",
    "node_modules.*",
    ".vite",
    "tmp",
    "target"
  ]
}
