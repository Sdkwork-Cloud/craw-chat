{
  "name": "@sdkwork/im-pc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm dev:standalone",
    "dev:standalone": "pnpm exec sdkwork-app dev --root ../.. --deployment-profile standalone",
    "dev:cloud": "pnpm exec sdkwork-app dev --root ../.. --deployment-profile cloud",
    "dev:browser": "pnpm dev:browser:postgres:standalone",
    "dev:browser:cloud": "pnpm exec sdkwork-app dev --root ../.. --runtime-target browser --deployment-profile cloud",
    "dev:desktop": "pnpm dev:desktop:postgres:standalone",
    "dev:desktop:cloud": "pnpm exec sdkwork-app dev --root ../.. --runtime-target desktop --deployment-profile cloud",
    "stop": "pnpm exec sdkwork-app stop --root ../..",
    "build:desktop:local": "pnpm --filter @sdkwork/im-pc-desktop build:desktop:local",
    "build": "pnpm exec sdkwork-app build",
    "test": "pnpm exec sdkwork-app test",
    "check": "pnpm exec sdkwork-app check",
    "verify": "pnpm exec sdkwork-app verify",
    "clean": "pnpm exec sdkwork-app clean",
    "_sdkwork:build": "node ../../scripts/dev/run-vite-cli.mjs build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "_sdkwork:test": "pnpm run test:workspace",
    "_sdkwork:check": "node ../../../sdkwork-specs/tools/check-app-manifest-standard.mjs --root . && node ../../../sdkwork-specs/tools/check-source-config-standard.mjs --root .",
    "_sdkwork:verify": "pnpm run _sdkwork:check && pnpm run _sdkwork:test",
    "_sdkwork:clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true});require('node:fs').rmSync('.vite',{recursive:true,force:true})\"",
    "_sdkwork:client:browser": "node ../../scripts/dev/run-vite-cli.mjs",
    "preview": "vite preview",
    "start": "node dist/server.cjs",
    "lint": "node ../../scripts/dev/run-tsc-cli.mjs --noEmit -p tsconfig.app.json",
    "test:notary-app-sdk-integration": "node scripts/notary-app-sdk-integration-contract.test.mjs",
    "test:drive-app-sdk-integration": "node scripts/drive-app-sdk-integration-contract.test.mjs",
    "test:voice-app-sdk-integration": "node scripts/voice-app-sdk-integration-contract.test.mjs",
    "test:knowledgebase-app-sdk-integration": "node scripts/knowledgebase-app-sdk-integration-contract.test.mjs",
    "test:commerce-app-sdk-integration": "node scripts/commerce-app-sdk-integration-contract.test.mjs",
    "test:token-plan-checkout": "node scripts/token-plan-checkout-contract.test.mjs",
    "test:mail-app-sdk-integration": "node scripts/mail-app-sdk-integration-contract.test.mjs",
    "test:course-app-sdk-integration": "node scripts/course-app-sdk-integration-contract.test.mjs",
    "test:course-backend-sdk-integration": "node scripts/course-backend-sdk-integration-contract.test.mjs",
    "test:community-app-sdk-integration": "node scripts/community-app-sdk-integration-contract.test.mjs",
    "test:domain-app-sdk-auth-runtime": "node scripts/domain-app-sdk-auth-runtime-contract.test.mjs",
    "test:aiot-devices-sdk-integration": "node scripts/sdkwork-chat-pc-aiot-devices-contract.test.mjs",
    "test:qr-scan-standard": "node ../../scripts/dev/run-tsx-cli.mjs scripts/qr-scan-standard-contract.test.ts",
    "test:communication-settings-sdk-boundary": "node scripts/communication-settings-sdk-boundary-contract.test.mjs",
    "test:pc-realtime-connection": "node ../../scripts/dev/run-tsx-cli.mjs --tsconfig scripts/pc-realtime-connection-test.tsconfig.json scripts/pc-realtime-connection-contract.test.ts",
    "test:chat-auth-realtime-guard": "node ../../scripts/dev/run-tsx-cli.mjs scripts/chat-auth-realtime-guard-contract.test.ts",
    "test:chat-message-pagination": "node scripts/chat-message-pagination-contract.test.mjs",
    "test:group-knowledgebase-launch": "node ../../scripts/dev/run-tsx-cli.mjs scripts/group-knowledgebase-launch-contract.test.ts",
    "test:agent-group-chat": "node ../../scripts/dev/run-tsx-cli.mjs scripts/agent-group-chat-contract.test.ts",
    "test:workspace": "pnpm run test:workspace-workbench && pnpm run test:workspace-service",
    "test:workspace-workbench": "node scripts/workspace-workbench-contract.test.mjs",
    "test:workspace-service": "node ../../scripts/dev/run-tsx-cli.mjs --tsconfig scripts/workspace-service-test.tsconfig.json scripts/workspace-service-contract.test.ts",
    "test:e2e": "playwright test",
    "dev:browser:postgres:standalone": "pnpm exec sdkwork-app dev --root ../.. --runtime-target browser --deployment-profile standalone",
    "dev:desktop:postgres:standalone": "pnpm exec sdkwork-app dev --root ../.. --runtime-target desktop --deployment-profile standalone",
    "build:dev": "node ../../../sdkwork-specs/tools/build-browser-client.mjs --app-root . --environment dev",
    "build:test": "node ../../../sdkwork-specs/tools/build-browser-client.mjs --app-root . --environment test",
    "build:staging": "node ../../../sdkwork-specs/tools/build-browser-client.mjs --app-root . --environment staging",
    "build:prod": "node ../../../sdkwork-specs/tools/build-browser-client.mjs --app-root . --environment prod",
    "build:dev:cloud": "node ../../../sdkwork-specs/tools/build-browser-client.mjs --app-root . --environment dev --deployment-profile cloud",
    "build:test:cloud": "node ../../../sdkwork-specs/tools/build-browser-client.mjs --app-root . --environment test --deployment-profile cloud",
    "build:staging:cloud": "node ../../../sdkwork-specs/tools/build-browser-client.mjs --app-root . --environment staging --deployment-profile cloud",
    "build:prod:cloud": "node ../../../sdkwork-specs/tools/build-browser-client.mjs --app-root . --environment prod --deployment-profile cloud"
  },
