# Generated from etc/topology/cloud.development.env (cloud.development).
# Regenerate with: pnpm workflow:materialize-client-env
# NOTE (2026-09-05): aligned to the domain-edge convention used by test/staging/
# production. The previous values baked dev-local surfaces into the DEPLOYED
# cloud.development bundle (VITE_SDKWORK_IM_PLATFORM_API_GATEWAY_HTTP_URL=
# http://127.0.0.1:3900 and :3801 module URLs), so the browser resolved API
# calls against the build machine's loopback instead of the api-dev edge.
# CAVEAT: re-running `pnpm workflow:materialize-client-env` re-binds the
# platform gateway key to SDKWORK_LOCAL_PLATFORM_API_GATEWAY_HTTP_URL for
# cloud.development (specs materializer behavior); the vite dev:cloud flow
# relies on that local binding, so the specs generator needs a dev-server vs
# build split before this file can be regenerated losslessly.
VITE_SDKWORK_AGENTS_APP_API_BASE_URL=http://im-dev.sdkwork.com
VITE_SDKWORK_CMS_APP_API_BASE_URL=http://im-dev.sdkwork.com
VITE_SDKWORK_DEPLOYMENT_PROFILE=cloud
VITE_SDKWORK_DRIVE_APP_API_BASE_URL=http://im-dev.sdkwork.com
VITE_SDKWORK_ENVIRONMENT=development
VITE_SDKWORK_IAM_API_BASE_URL=http://im-dev.sdkwork.com
VITE_SDKWORK_IM_API_BASE_URL=http://im-dev.sdkwork.com
VITE_SDKWORK_IM_APPLICATION_PUBLIC_HTTP_URL=http://im-dev.sdkwork.com
VITE_SDKWORK_IM_APPLICATION_PUBLIC_WEBSOCKET_URL=wss://api-dev.sdkwork.com
VITE_SDKWORK_IM_DEPLOYMENT_PROFILE=cloud
VITE_SDKWORK_IM_ENVIRONMENT=development
VITE_SDKWORK_IM_H5_APPLICATION_PUBLIC_HTTP_URL=http://im-dev.sdkwork.com
VITE_SDKWORK_IM_PLATFORM_API_GATEWAY_HTTP_URL=https://api-dev.sdkwork.com
VITE_SDKWORK_IM_PROFILE_ID=cloud.development
VITE_SDKWORK_IM_RUNTIME_TARGET=browser
