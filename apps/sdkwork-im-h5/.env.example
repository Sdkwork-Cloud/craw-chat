# SDKWork IM H5 public browser runtime environment.
# Copy to `.env.local` (gitignored) and adjust for local development.
# VITE_* variables are public non-secret build/dev inputs only.
# Secrets, tokens, refresh tokens, and private service endpoints MUST NOT live here.

# Deployment profile: standalone | cloud
VITE_SDKWORK_DEPLOYMENT_PROFILE=standalone

# IM application public HTTP base URL (browser-facing).
VITE_SDKWORK_IM_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:4178

# IM application public WebSocket base URL (browser-facing).
VITE_SDKWORK_IM_APPLICATION_PUBLIC_WEBSOCKET_URL=ws://127.0.0.1:4178

# IM platform API gateway HTTP URL (browser-facing).
VITE_SDKWORK_IM_PLATFORM_API_GATEWAY_HTTP_URL=http://127.0.0.1:4178

# IM app SDK base URL.
VITE_SDKWORK_IM_API_BASE_URL=http://127.0.0.1:4178

# Drive app SDK base URL.
VITE_SDKWORK_DRIVE_APP_API_BASE_URL=http://127.0.0.1:4178

# IAM API base URL.
VITE_SDKWORK_IAM_API_BASE_URL=http://127.0.0.1:4178

# Optional H5 module composition. Omit to keep the release default: chat,notary.
# Only modules with completed runtime contracts may be selected.
# VITE_SDKWORK_IM_H5_MODULES=chat,notary,contacts,drive

# Optional auth development prefill (local development only).
# VITE_SDKWORK_IM_AUTH_DEV_DEFAULT_ACCOUNT=
# VITE_SDKWORK_IM_AUTH_DEV_DEFAULT_EMAIL=
# VITE_SDKWORK_IM_AUTH_DEV_DEFAULT_PHONE=
# VITE_SDKWORK_IM_AUTH_DEV_DEFAULT_PASSWORD=
