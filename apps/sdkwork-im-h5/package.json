{
  "name": "@sdkwork/im-h5",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm dev:standalone",
    "dev:standalone": "pnpm exec sdkwork-app dev --root ../.. --deployment-profile standalone",
    "dev:cloud": "pnpm exec sdkwork-app dev --root ../.. --deployment-profile cloud",
    "dev:browser": "pnpm dev:browser:postgres:standalone",
    "dev:browser:cloud": "pnpm exec sdkwork-app dev --root ../.. --runtime-target browser --deployment-profile cloud",
    "dev:browser:postgres:standalone": "pnpm exec sdkwork-app dev --root ../.. --runtime-target browser --deployment-profile standalone",
    "stop": "pnpm exec sdkwork-app stop --root ../..",
    "build": "pnpm exec sdkwork-app build",
    "build:browser": "pnpm exec sdkwork-app build --root ../.. --runtime-target browser",
    "build:browser:staging": "pnpm exec sdkwork-app build --root ../.. --runtime-target browser --build-mode staging",
    "build:browser:prod": "pnpm exec sdkwork-app build --root ../.. --runtime-target browser --build-mode production",
    "build:staging": "pnpm exec sdkwork-app build --root ../.. --build-mode staging",
    "build:prod": "pnpm exec sdkwork-app build --root ../.. --build-mode production",
    "preview:browser": "vite preview",
    "preview": "vite preview",
    "test": "pnpm exec sdkwork-app test",
    "test:config": "node ../../../sdkwork-specs/tools/check-source-config-standard.mjs --root .",
    "check": "pnpm exec sdkwork-app check",
    "verify": "pnpm exec sdkwork-app verify",
    "clean": "pnpm exec sdkwork-app clean",
    "_sdkwork:build": "node ../../scripts/dev/run-vite-cli.mjs build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "_sdkwork:test": "pnpm run test:workspace",
    "_sdkwork:check": "node ../../../sdkwork-specs/tools/check-app-manifest-standard.mjs --root . && node ../../../sdkwork-specs/tools/check-source-config-standard.mjs --root .",
    "_sdkwork:verify": "pnpm run _sdkwork:check && pnpm run _sdkwork:test",
    "_sdkwork:clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "start": "node dist/server.cjs",
    "lint": "node ../../scripts/dev/run-tsc-cli.mjs --noEmit -p tsconfig.json",
    "typecheck": "node ../../scripts/dev/run-tsc-cli.mjs --noEmit -p tsconfig.json",
    "test:workspace": "node --test tests/"
  },
  "dependencies": {
    "@sdkwork/auth-pc-react": "workspace:*",
    "@sdkwork/auth-runtime-pc-react": "workspace:*",
    "@sdkwork/im-h5-chat": "workspace:*",
    "@sdkwork/im-h5-core": "workspace:*",
    "@sdkwork/im-app-sdk": "workspace:*",
    "@sdkwork/im-sdk": "workspace:*",
    "@sdkwork/drive-app-sdk": "workspace:*",
    "@sdkwork/sdk-common": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tiptap/extension-placeholder": "catalog:",
    "@tiptap/react": "catalog:",
    "@tiptap/starter-kit": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "clsx": "catalog:",
    "date-fns": "^4.1.0",
    "dotenv": "catalog:",
    "express": "catalog:",
    "html-to-image": "^1.11.13",
    "i18next": "catalog:",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "catalog:",
    "motion": "catalog:",
    "qrcode.react": "^4.2.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-easy-crop": "^5.5.7",
    "react-i18next": "catalog:",
    "react-qr-code": "catalog:",
    "react-router": "catalog:",
    "react-router-dom": "catalog:",
    "react-signature-canvas": "1.1.0-alpha.2",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "vite": "catalog:",
    "zustand": "catalog:",
    "@google/genai": "^1.29.0",
    "@types/react-signature-canvas": "^1.0.7"
  },
  "devDependencies": {
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "autoprefixer": "catalog:",
    "esbuild": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
