{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "react": [
        "./node_modules/@types/react/index.d.ts"
      ],
      "react/jsx-runtime": [
        "./node_modules/@types/react/jsx-runtime.d.ts"
      ],
      "react-dom": [
        "./node_modules/@types/react-dom/index.d.ts"
      ],
      "react-router-dom": [
        "./node_modules/react-router-dom/dist/index.d.ts"
      ],
      "@sdkwork/im-app-sdk": [
        "../../sdks/sdkwork-im-app-sdk/sdkwork-im-app-sdk-typescript/src/index.ts"
      ],
      "@sdkwork/im-backend-sdk": [
        "../../sdks/sdkwork-im-backend-sdk/sdkwork-im-backend-sdk-typescript/src/index.ts"
      ],
      "@sdkwork/im-sdk": [
        "../../sdks/sdkwork-im-sdk/sdkwork-im-sdk-typescript/src/index.ts"
      ],
      "@sdkwork/iam-app-sdk": [
        "../../../sdkwork-iam/sdks/sdkwork-iam-app-sdk/sdkwork-iam-app-sdk-typescript/src/index.ts"
      ],
      "@sdkwork/iam-backend-sdk": [
        "../../../sdkwork-iam/sdks/sdkwork-iam-backend-sdk/sdkwork-iam-backend-sdk-typescript/src/index.ts"
      ],
      "@sdkwork/drive-app-sdk": [
        "../../../sdkwork-drive/sdks/sdkwork-drive-app-sdk/sdkwork-drive-app-sdk-typescript/src/index.ts"
      ],
      "@sdkwork/rtc-sdk": [
        "../../../sdkwork-rtc/sdks/sdkwork-rtc-sdk/sdkwork-rtc-sdk-typescript/src/index.ts"
      ],
      "@sdkwork/appbase-pc-react": [
        "../../../sdkwork-appbase/packages/pc-react/foundation/sdkwork-appbase-pc-react/src/index.ts"
      ],
      "@sdkwork/auth-pc-react": [
        "../../../sdkwork-iam/apps/sdkwork-iam-pc/packages/sdkwork-auth-pc-react/src/index.ts"
      ],
      "@sdkwork/auth-runtime-pc-react": [
        "../../../sdkwork-iam/apps/sdkwork-iam-pc/packages/sdkwork-auth-runtime-pc-react/src/index.ts"
      ],
      "@sdkwork/i18n-pc-react": [
        "../../../sdkwork-appbase/packages/pc-react/foundation/sdkwork-i18n-pc-react/src/index.ts"
      ],
      "@sdkwork/core-pc-react": [
        "../../../sdkwork-core/sdkwork-core-pc-react/src/index.ts"
      ],
      "@sdkwork/core-pc-react/*": [
        "../../../sdkwork-core/sdkwork-core-pc-react/src/*/index.ts"
      ],
      "@sdkwork/ui-pc-react/styles.css": [
        "../../../sdkwork-ui/sdkwork-ui-pc-react/src/styles/sdkwork-ui.css"
      ],
      "@sdkwork/ui-pc-react": [
        "../../../sdkwork-ui/sdkwork-ui-pc-react/src/index.ts"
      ],
      "@sdkwork/ui-pc-react/*": [
        "../../../sdkwork-ui/sdkwork-ui-pc-react/src/*"
      ],
      "@sdkwork/sdk-common": [
        "../../../sdkwork-sdk-commons/sdkwork-sdk-common-typescript/src/index.ts"
      ],
      "@sdkwork/sdk-common/core": [
        "../../../sdkwork-sdk-commons/sdkwork-sdk-common-typescript/src/core/index.ts"
      ],
      "@sdkwork/sdk-common/auth": [
        "../../../sdkwork-sdk-commons/sdkwork-sdk-common-typescript/src/auth/index.ts"
      ],
      "@sdkwork/sdk-common/http": [
        "../../../sdkwork-sdk-commons/sdkwork-sdk-common-typescript/src/http/index.ts"
      ],
      "@sdkwork/sdk-common/errors": [
        "../../../sdkwork-sdk-commons/sdkwork-sdk-common-typescript/src/errors/index.ts"
      ],
      "@sdkwork/sdk-common/utils": [
        "../../../sdkwork-sdk-commons/sdkwork-sdk-common-typescript/src/utils/index.ts"
      ],
      "@sdkwork/utils": [
        "../../../sdkwork-utils/packages/sdkwork-utils-typescript/src/index.ts"
      ],
      "@sdkwork/im-h5-types/*": [
        "./packages/sdkwork-im-h5-types/src/*"
      ],
      "@sdkwork/im-h5-types": [
        "./packages/sdkwork-im-h5-types/src/index.ts"
      ],
      "@sdkwork/im-h5-commons/*": [
        "./packages/sdkwork-im-h5-commons/src/*"
      ],
      "@sdkwork/im-h5-commons": [
        "./packages/sdkwork-im-h5-commons/src/index.ts"
      ],
      "@sdkwork/im-h5-core/*": [
        "./packages/sdkwork-im-h5-core/src/*"
      ],
      "@sdkwork/im-h5-core": [
        "./packages/sdkwork-im-h5-core/src/index.ts"
      ],
      "@sdkwork/im-h5-chat/*": [
        "./packages/sdkwork-im-h5-chat/src/*"
      ],
      "@sdkwork/im-h5-chat": [
        "./packages/sdkwork-im-h5-chat/src/index.ts"
      ],
      "@sdkwork/im-h5-contacts": [
        "./packages/sdkwork-im-h5-contacts/src/index.ts"
      ],
      "@sdkwork/im-h5-user": [
        "./packages/sdkwork-im-h5-user/src/index.ts"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "exclude": [
    "dist",
    "node_modules",
    "node_modules.*",
    ".runtime",
    ".vite",
    "tmp",
    "target"
  ]
}
