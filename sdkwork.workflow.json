  "lifecycle": {
    "preflight": [
      {
        "name": "Install native release prerequisites",
        "shell": "pwsh",
        "run": "$ErrorActionPreference = \"Stop\"\n$PSNativeCommandUseErrorActionPreference = $true\nif ($env:SDKWORK_PACKAGE_PROFILE -eq \"desktop\" -and $env:SDKWORK_PACKAGE_PLATFORM -eq \"linux\") {\n  sudo apt-get update\n  sudo apt-get install -y libwebkit2gtk-4.1-dev libayatana-appindicator3-dev librsvg2-dev patchelf\n}"
      }
    ],
    "install": [
      {
        "name": "Install workspace dependencies",
        "shell": "pwsh",
        "run": "$ErrorActionPreference = \"Stop\"\n$PSNativeCommandUseErrorActionPreference = $true\n$env:SDKWORK_SHARED_SDK_MODE = \"git\"\n$env:SDKWORK_SHARED_SDK_GITHUB_TOKEN = $env:GH_TOKEN\npnpm install --no-frozen-lockfile --config.auto-install-peers=false"
      }
    ],
    "build": [
      {
        "name": "Validate SDKWork dependency management",
        "shell": "pwsh",
        "run": "$ErrorActionPreference = \"Stop\"\n$PSNativeCommandUseErrorActionPreference = $true\npnpm check:dependency-management"
      },
      {
        "name": "Validate release contract",
        "shell": "pwsh",
        "run": "$ErrorActionPreference = \"Stop\"\n$PSNativeCommandUseErrorActionPreference = $true\nnode scripts/release/sdkwork-im-release-package.test.mjs\nnode scripts/release/plan-sdkwork-im-install-packages.mjs --check --version $env:SDKWORK_PACKAGE_VERSION\nnode scripts/release/plan-sdkwork-im-native-install-packages.mjs --check --version $env:SDKWORK_PACKAGE_VERSION\npnpm release:package:check -- --json --version $env:SDKWORK_PACKAGE_VERSION"
      },
      {
        "name": "Build selected production artifacts",
        "shell": "pwsh",
        "env": {
          "SDKWORK_SHARED_SDK_MODE": "git"
        },
        "run": "$ErrorActionPreference = \"Stop\"\n$PSNativeCommandUseErrorActionPreference = $true\n$env:SDKWORK_IM_RELEASE_VERSION = $env:SDKWORK_PACKAGE_VERSION\n$env:SDKWORK_SHARED_SDK_GITHUB_TOKEN = $env:GH_TOKEN\nif ($env:SDKWORK_PACKAGE_PROFILE -eq \"browser\" -and $env:SDKWORK_PACKAGE_PLATFORM -eq \"web\") {\n  pnpm release:build:prod -- --target browser\n} elseif ($env:SDKWORK_PACKAGE_PROFILE -eq \"server\") {\n  pnpm release:build:prod -- --target server\n} elseif ($env:SDKWORK_PACKAGE_PROFILE -eq \"desktop\") {\n  pnpm release:build:prod -- --target desktop --platform $env:SDKWORK_PACKAGE_PLATFORM --arch $env:SDKWORK_PACKAGE_ARCHITECTURE\n} else {\n  node scripts/release/workflow-release-target.mjs build --package-id $env:SDKWORK_PACKAGE_ID --version $env:SDKWORK_PACKAGE_VERSION\n}"
      }
    ],
    "stage": [
      {
        "name": "Stage selected release package",
        "shell": "pwsh",
        "run": "$ErrorActionPreference = \"Stop\"\n$PSNativeCommandUseErrorActionPreference = $true\nif ($env:SDKWORK_PACKAGE_PROFILE -in @(\"browser\", \"server\", \"desktop\") -and $env:SDKWORK_PACKAGE_PLATFORM -ne \"h5\" -and $env:SDKWORK_PACKAGE_FORMAT -notin @(\"deb\", \"msi\", \"pkg\", \"appimage\", \"exe\", \"dmg\")) {\n  pnpm release:stage -- --package-id $env:SDKWORK_PACKAGE_ID --version $env:SDKWORK_PACKAGE_VERSION\n}"
      }
    ],
    "package": [
      {
        "name": "Build selected release package",
        "shell": "pwsh",
        "run": "$ErrorActionPreference = \"Stop\"\n$PSNativeCommandUseErrorActionPreference = $true\nif ($env:SDKWORK_PACKAGE_PROFILE -eq \"server\" -and $env:SDKWORK_PACKAGE_FORMAT -in @(\"deb\", \"msi\", \"pkg\")) {\n  node scripts/release/build-sdkwork-im-native-installer.mjs --package-id $env:SDKWORK_PACKAGE_ID --version $env:SDKWORK_PACKAGE_VERSION\n} elseif ($env:SDKWORK_PACKAGE_PROFILE -eq \"desktop\" -and $env:SDKWORK_PACKAGE_FORMAT -in @(\"deb\", \"msi\", \"exe\", \"appimage\", \"dmg\")) {\n  node scripts/release/workflow-release-target.mjs package --package-id $env:SDKWORK_PACKAGE_ID --version $env:SDKWORK_PACKAGE_VERSION\n} elseif ($env:SDKWORK_PACKAGE_PROFILE -in @(\"browser\", \"server\", \"desktop\") -and $env:SDKWORK_PACKAGE_PLATFORM -ne \"h5\") {\n  node scripts/release/build-sdkwork-im-install-package.mjs --package-id $env:SDKWORK_PACKAGE_ID --version $env:SDKWORK_PACKAGE_VERSION\n} else {\n  node scripts/release/workflow-release-target.mjs package --package-id $env:SDKWORK_PACKAGE_ID --version $env:SDKWORK_PACKAGE_VERSION\n}"
      }
    ],
    "sign": [
      {
        "name": "Sign release artifacts",
        "shell": "pwsh",
        "run": "$ErrorActionPreference = \"Stop\"\n$PSNativeCommandUseErrorActionPreference = $true\nnode scripts/release/workflow-supply-chain-evidence.mjs sign"
      }
    ],
    "sbom": [
      {
        "name": "Generate release SBOM",
        "shell": "pwsh",
        "run": "$ErrorActionPreference = \"Stop\"\n$PSNativeCommandUseErrorActionPreference = $true\nnode scripts/release/workflow-supply-chain-evidence.mjs attest"
      }
    ],
    "validate": [
      {
        "name": "Validate selected release package",
        "shell": "pwsh",
        "run": "$ErrorActionPreference = \"Stop\"\n$PSNativeCommandUseErrorActionPreference = $true\nif ($env:SDKWORK_PACKAGE_PROFILE -eq \"desktop\" -and $env:SDKWORK_PACKAGE_FORMAT -in @(\"deb\", \"msi\", \"exe\", \"appimage\", \"dmg\")) {\n  node scripts/release/workflow-release-target.mjs validate --package-id $env:SDKWORK_PACKAGE_ID --version $env:SDKWORK_PACKAGE_VERSION\n} elseif ($env:SDKWORK_PACKAGE_PROFILE -in @(\"browser\", \"server\", \"desktop\") -and $env:SDKWORK_PACKAGE_PLATFORM -ne \"h5\") {\n  $extension = if ($env:SDKWORK_PACKAGE_FORMAT -eq \"tar.gz\") { \"tar.gz\" } else { $env:SDKWORK_PACKAGE_FORMAT }\n  $pattern = \"sdkwork-im-$env:SDKWORK_PACKAGE_ID-*.$extension\"\n  $artifact = Get-ChildItem -Path \"dist/release-packages\" -File | Where-Object { $_.Name -like $pattern -and $_.Name -notlike \"*.manifest.json\" } | Select-Object -First 1\n  if (-not $artifact) { throw \"Missing Sdkwork IM release artifact for $env:SDKWORK_PACKAGE_ID matching $pattern\" }\n  node scripts/release/validate-sdkwork-im-install-artifacts.mjs --package-id $env:SDKWORK_PACKAGE_ID --artifact-path $artifact.FullName --version $env:SDKWORK_PACKAGE_VERSION --json\n} else {\n  node scripts/release/workflow-release-target.mjs validate --package-id $env:SDKWORK_PACKAGE_ID --version $env:SDKWORK_PACKAGE_VERSION\n}"
      }
    ],
    "deploy": [
      {
        "name": "Apply immutable artifact through the SDKWork app facade",
        "shell": "pwsh",
        "run": "$ErrorActionPreference = \"Stop\"\n$PSNativeCommandUseErrorActionPreference = $true\npnpm exec sdkwork-app deploy:workflow-apply"
      }
    ]
  },
